      "id": "change-sound", "title": "Change the sound", "controls": [11, 27], "steps": [], "comingSoon": true,
      "notes": [
        { "text": "Sounds 000 to 131 are printed on the left of the panel (000 is Acoustic Grand Piano). 132 to 254 are listed in the manual.", "verified": true, "source": "S2" },
        { "text": "Press TIMBRE, then type the sound's number on the number buttons.", "verified": false, "source": "S4" }
      ]
    },
    {
      "id": "teaching-modes", "title": "Use the teaching modes (One Key, Follow, Ensemble)", "controls": [23, 24, 25, 13], "steps": [], "comingSoon": true,
      "notes": [
        { "text": "Your keyboard has three teaching buttons: ONE-KEY, FOLLOW and ENSEMBLE (the panel calls this the KEY LIGHTING 3-STEP LESSON).", "verified": true, "source": "S2" },
        { "text": "The keys light up to show which notes to play during a lesson.", "verified": false, "source": "S3" }
      ]
    },
    {
      "id": "record", "title": "Record yourself", "controls": [17, 19, 18], "steps": [], "comingSoon": true,
      "notes": [
        { "text": "The buttons are REC (record) and PLAY (play it back).", "verified": true, "source": "S2" },
        { "text": "The keyboard can record what you play and play it back.", "verified": false, "source": "S3" }
      ]
    },
