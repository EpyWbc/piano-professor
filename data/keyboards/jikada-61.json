    { "id": "timbre", "num": 11, "label": "TIMBRE", "group": "sound", "does": "Chooses the instrument sound (timbre). The panel lists sounds 000 to 131; 132 to 254 are in the manual.", "verified": true, "source": "S2", "panel": { "row": 1, "col": 2 } },
    { "id": "rhythm", "num": 12, "label": "RHYTHM", "group": "sound", "does": "Chooses the backing rhythm style. The panel lists rhythms 000 to 155; 156 to 254 are in the manual.", "verified": true, "source": "S2", "panel": { "row": 2, "col": 2 } },
    { "id": "key-lighting", "num": 13, "label": "KEY LIGHTING", "group": "sound", "does": "Turns the lighted keys on or off.", "verified": false, "source": "S3", "panel": { "row": 1, "col": 3 } },
    { "id": "demo-song", "num": 14, "label": "DEMO SONG", "group": "sound", "does": "Plays the built-in demo songs (there are 50).", "verified": false, "source": "S3", "panel": { "row": 2, "col": 3 } },
    { "id": "lcd", "num": 15, "label": "LCD display", "group": "display", "does": "The screen in the middle of the panel.", "verified": true, "source": "S1", "panel": { "row": 1, "col": 1 } },
    { "id": "keyboard-percussion", "num": 16, "label": "KEYBOARD PERCUSSION", "group": "effects", "does": "Turns the keys into drum and percussion sounds (61 of them).", "verified": false, "source": "S3", "panel": { "row": 1, "col": 1 } },
    { "id": "rec", "num": 17, "label": "REC", "group": "effects", "does": "Records what you play.", "verified": false, "source": "S3", "panel": { "row": 1, "col": 2 } },
    { "id": "prog", "num": 18, "label": "PROG", "group": "effects", "does": "", "verified": false, "source": "S1", "panel": { "row": 1, "col": 3 } },
    { "id": "play", "num": 19, "label": "PLAY", "group": "effects", "does": "Plays back your recording.", "verified": false, "source": "S3", "panel": { "row": 1, "col": 4 } },
    { "id": "split", "num": 20, "label": "SPLIT", "group": "effects", "does": "Gives the left and right sides of the keyboard two different sounds.", "verified": false, "source": "S3", "panel": { "row": 2, "col": 1 } },
    { "id": "sustain", "num": 21, "label": "SUSTAIN", "group": "effects", "does": "Makes notes ring on longer. Press again to turn it off.", "verified": false, "source": "S3", "panel": { "row": 2, "col": 2 } },
    { "id": "vibrato", "num": 22, "label": "VIBRATO", "group": "effects", "does": "Adds a gentle wobble (vibrato) to the sound. Press again to turn it off.", "verified": false, "source": "S3", "panel": { "row": 2, "col": 3 } },
    { "id": "one-key", "num": 23, "label": "ONE-KEY", "group": "lesson", "does": "Teaching mode 1: press any key and the keyboard plays the correct next note of the song.", "verified": false, "source": "S4", "panel": { "row": 1, "col": 1 } },
    { "id": "follow", "num": 24, "label": "FOLLOW", "group": "lesson", "does": "Teaching mode 2: the keyboard waits for you to play the correct (lit) note.", "verified": false, "source": "S4", "panel": { "row": 2, "col": 1 } },
    { "id": "ensemble", "num": 25, "label": "ENSEMBLE", "group": "lesson", "does": "Teaching mode 3: play the song along with the accompaniment.", "verified": false, "source": "S4", "panel": { "row": 3, "col": 1 } },
    { "id": "memory", "num": 26, "label": "MEMORY · M1 M2 M3", "group": "numbers", "does": "Saves your sound, rhythm and tempo settings so you can get them back later.", "verified": false, "source": "S3", "panel": { "row": 1, "col": 1 } },
    { "id": "numbers", "num": 27, "label": "0–9 · + · −", "group": "numbers", "does": "The number buttons, for picking a sound, rhythm or song by its number.", "verified": false, "source": "S4", "panel": { "row": 2, "col": 1 } },
    { "id": "single-chord", "num": 28, "label": "SINGLE CHORD", "group": "chords", "does": "One-finger automatic chords: press one key on the left and get a full chord.", "verified": false, "source": "S3", "panel": { "row": 1, "col": 1 } },
    { "id": "fingered-chord", "num": 29, "label": "FINGERED CHORD", "group": "chords", "does": "Automatic accompaniment from the full chord you play on the left.", "verified": false, "source": "S3", "panel": { "row": 1, "col": 2 } },
    { "id": "chord-timbre", "num": 30, "label": "CHORD TIMBRE", "group": "chords", "does": "", "verified": false, "source": "S1", "panel": { "row": 2, "col": 1 } },
    { "id": "chord-off", "num": 31, "label": "CHORD OFF", "group": "chords", "does": "Turns the automatic chords off.", "verified": true, "source": "S2", "panel": { "row": 2, "col": 2 } },
    { "id": "metronome", "num": 32, "label": "METRONOME", "group": "sound", "does": "Turns on the keyboard's built-in metronome (a steady click to keep time).", "verified": false, "source": "S3", "panel": { "row": 3, "col": 1 } },
    { "id": "start-stop", "num": 33, "label": "START/STOP", "group": "sound", "does": "Starts or stops the rhythm.", "verified": false, "source": "S4", "panel": { "row": 3, "col": 2 } },
    { "id": "master-vol", "num": 34, "label": "MASTER VOL −/+", "group": "volume-tempo", "does": "Turns the whole keyboard quieter (−) or louder (+).", "verified": true, "source": "S2", "panel": { "row": 1, "col": 1 } },
    { "id": "accom-vol", "num": 35, "label": "ACCOM VOL −/+", "group": "volume-tempo", "does": "Turns the accompaniment (the backing rhythm and chords) quieter (−) or louder (+).", "verified": true, "source": "S2", "panel": { "row": 1, "col": 2 } },
    { "id": "tempo", "num": 36, "label": "TEMPO −/+", "group": "volume-tempo", "does": "Makes the rhythm slower (−) or faster (+).", "verified": true, "source": "S2", "panel": { "row": 1, "col": 3 } },
    { "id": "transpose", "num": 37, "label": "TRANSPOSE −/+", "group": "volume-tempo", "does": "Shifts every key lower (−) or higher (+) in pitch.", "verified": true, "source": "S2", "panel": { "row": 1, "col": 4 } },
    { "id": "chord-zone", "num": 38, "label": "+ AUTO BASS CHORD", "group": "keys", "does": "The keys at the left end, used for the automatic chords. Exactly which keys: details coming soon.", "verified": false, "source": "S1", "panel": { "row": 1, "col": 2 } },
    { "id": "udisk", "num": 39, "label": "UDISK", "group": "ports", "does": "Back of the keyboard: plug in a USB stick with MP3 music (the panel calls it the UDISK Music Player). This is not a computer/MIDI port.", "verified": true, "source": "S2", "panel": { "row": 1, "col": 1 } },
    { "id": "audio-input", "num": 40, "label": "AUDIO INPUT", "group": "ports", "does": "Back of the keyboard: plug in a phone or tablet to play its music through the keyboard's speakers.", "verified": false, "source": "S4", "panel": { "row": 1, "col": 2 } },
    { "id": "mic", "num": 41, "label": "MIC", "group": "ports", "does": "Back of the keyboard: plug in the microphone.", "verified": true, "source": "S1", "panel": { "row": 1, "col": 3 } },
    { "id": "phones-output", "num": 42, "label": "PHONES/OUTPUT", "group": "ports", "does": "Back of the keyboard: plug in headphones.", "verified": true, "source": "S1", "panel": { "row": 1, "col": 4 } },
    { "id": "dc-12v", "num": 43, "label": "DC 12V", "group": "ports", "does": "Back of the keyboard: the power adapter plugs in here (12 volts).", "verified": true, "source": "S1", "panel": { "row": 1, "col": 5 } }
