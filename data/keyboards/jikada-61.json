    { "id": "power", "num": 2, "label": "POWER", "group": "power", "does": "Turns the keyboard on (ON) or off (OFF).", "verified": true, "source": "S2", "panel": { "row": 1, "col": 1 } },
    { "id": "mp3-prev-next", "num": 3, "label": "Previous/Next", "group": "mp3", "does": "Part of the MP3 player for a USB stick: skips to the previous or next track.", "verified": false, "source": "S4", "panel": { "row": 1, "col": 1 } },
