    { "id": "mp3-stop", "num": 5, "label": "Stop", "group": "mp3", "does": "Part of the MP3 player for a USB stick: stops the track.", "verified": false, "source": "S4", "panel": { "row": 1, "col": 3 } },
    { "id": "mp3-volume", "num": 6, "label": "MP3 Volume Control", "group": "mp3", "does": "Makes the MP3 music louder or quieter.", "verified": false, "source": "S4", "panel": { "row": 2, "col": 1 } },
    { "id": "mp3-order", "num": 7, "label": "Sequence/Random/Single", "group": "mp3", "does": "Chooses the order MP3 tracks play in: in sequence, random, or one track.", "verified": false, "source": "S4", "panel": { "row": 2, "col": 2 } },
