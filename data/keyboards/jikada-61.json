  "troubleshooting": [
    {
      "id": "no-sound", "title": "No sound",
      "steps": [
        { "text": "Check the power adapter is plugged into DC 12V on the back and the keyboard is switched ON.", "verified": true, "source": "S1" },
        { "text": "Turn MASTER VOL up with the + button.", "verified": true, "source": "S2" },
        { "text": "Unplug any headphones from PHONES/OUTPUT: the speakers go quiet while headphones are plugged in.", "verified": false, "source": "S4" }
      ]
    },
    {
      "id": "keys-lighting", "title": "Keys aren't lighting (or lighting wrong)",
      "steps": [
        { "text": "Press KEY LIGHTING to turn the lights on.", "verified": false, "source": "S4" },
        { "text": "The lights show the notes during a lesson, so start a teaching mode (ONE-KEY, FOLLOW or ENSEMBLE).", "verified": false, "source": "S4" }
      ]
    },
    {
      "id": "wrong-pitch", "title": "Everything sounds too high or too low",
      "steps": [
        { "text": "Transpose may be on. Use TRANSPOSE −/+ to set it back to 00.", "verified": false, "source": "S4" }
      ]
    },
    {
      "id": "notes-ring", "title": "Notes won't stop ringing",
      "steps": [
        { "text": "SUSTAIN is probably on. Press SUSTAIN again to turn it off.", "verified": false, "source": "S4" }
      ]
    },
    {
      "id": "reset", "title": "It's frozen / how to reset",
      "steps": [
        { "text": "Switch off, unplug the adapter for 60 seconds, then plug in and switch on again.", "verified": false, "source": "S4" },
